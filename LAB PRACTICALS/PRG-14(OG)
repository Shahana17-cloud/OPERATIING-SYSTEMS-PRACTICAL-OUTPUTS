files = []

while True:
    print("\n1. Create File")
    print("2. List Files")
    print("3. Delete File")
    print("4. Exit")

    choice = int(input("Enter choice: "))

    if choice == 1:
        name = input("Enter file name: ")

        if name in files:
            print("File already exists")
        else:
            files.append(name)
            print("File created")

    elif choice == 2:
        print("Files in directory:")
        for f in files:
            print(f)

    elif choice == 3:
        name = input("Enter file name to delete: ")

        if name in files:
            files.remove(name)
            print("File deleted")
        else:
            print("File not found")

    elif choice == 4:
        break

    else:
        print("Invalid choice")
