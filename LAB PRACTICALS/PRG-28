#include <stdio.h>
#include <string.h>

int main()
{
    FILE *fp;
    char filename[100];
    char pattern[50];
    char line[200];
    int lineNumber = 0;

    printf("Enter file name: ");
    scanf("%s", filename);

    printf("Enter search pattern: ");
    scanf("%s", pattern);

    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        perror("File opening failed");
        return 1;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        lineNumber++;

        if (strstr(line, pattern) != NULL)
        {
            printf("%d: %s", lineNumber, line);
        }
    }

    fclose(fp);

    return 0;
}
