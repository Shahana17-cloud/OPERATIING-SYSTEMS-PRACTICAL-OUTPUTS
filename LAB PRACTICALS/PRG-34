#include <stdio.h>

int main() {
    int start, length, i;

    printf("Enter starting block: ");
    scanf("%d", &start);

    printf("Enter number of blocks: ");
    scanf("%d", &length);

    printf("\nSequential File Allocation:\n");
    printf("File blocks are allocated as:\n");

    for (i = 0; i < length; i++)
        printf("Block %d -> %d\n", i + 1, start + i);

    return 0;
}
