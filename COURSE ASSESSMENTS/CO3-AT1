4.#include<stdio.h>
int main()
{
    float m,t,h;
    printf("Memory TLB HitRatio: ");
    scanf("%f%f%f",&m,&t,&h);

    printf("Without TLB = %.2f\n",2*m);
    printf("With TLB = %.2f",h*(t+m)+(1-h)*(t+2*m));

    return 0;
}

OUTPUT:
Memory TLB HitRatio: 100
10
.08
Without TLB = 200.00
With TLB = 202.00

