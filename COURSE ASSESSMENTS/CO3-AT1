3.#include<stdio.h>
int main()
{
    int pt[10],n,p,o;
    printf("Pages: ");
    scanf("%d",&n);

    for(int i=0;i<n;i++)
    {
        printf("Frame for Page %d: ",i);
        scanf("%d",&pt[i]);
    }

    printf("Page Offset: ");
    scanf("%d%d",&p,&o);

    printf("Page %d -> Frame %d\n",p,pt[p]);
    printf("Physical Address = %d",pt[p]*100+o);

    return 0;
}

